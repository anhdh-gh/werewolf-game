          ".validate": "newData.hasChildren(['roleCounts', 'remoteMode']) && newData.child('remoteMode').isBoolean() && newData.child('roleCounts').hasChildren(['WEREWOLF', 'TRAITOR', 'SORCERER', 'WOLF_MAN', 'WOLF_CUB', 'SEER', 'WITCH', 'BODYGUARD', 'HUNTER', 'CUPID', 'MUTER', 'CURSED', 'LYCAN', 'MASON', 'PRINCE', 'PACIFIST', 'VILLAGE_IDIOT', 'VILLAGER', 'TANNER']) && newData.child('roleCounts').child('WEREWOLF').isNumber() && newData.child('roleCounts').child('WEREWOLF').val() >= 0 && newData.child('roleCounts').child('WEREWOLF').val() <= 16 && newData.child('roleCounts').child('TRAITOR').isNumber() && newData.child('roleCounts').child('TRAITOR').val() >= 0 && newData.child('roleCounts').child('TRAITOR').val() <= 16 && newData.child('roleCounts').child('SORCERER').isNumber() && newData.child('roleCounts').child('SORCERER').val() >= 0 && newData.child('roleCounts').child('SORCERER').val() <= 16 && newData.child('roleCounts').child('WOLF_MAN').isNumber() && newData.child('roleCounts').child('WOLF_MAN').val() >= 0 && newData.child('roleCounts').child('WOLF_MAN').val() <= 16 && newData.child('roleCounts').child('WOLF_CUB').isNumber() && newData.child('roleCounts').child('WOLF_CUB').val() >= 0 && newData.child('roleCounts').child('WOLF_CUB').val() <= 16 && newData.child('roleCounts').child('SEER').isNumber() && newData.child('roleCounts').child('SEER').val() >= 0 && newData.child('roleCounts').child('SEER').val() <= 16 && newData.child('roleCounts').child('WITCH').isNumber() && newData.child('roleCounts').child('WITCH').val() >= 0 && newData.child('roleCounts').child('WITCH').val() <= 16 && newData.child('roleCounts').child('BODYGUARD').isNumber() && newData.child('roleCounts').child('BODYGUARD').val() >= 0 && newData.child('roleCounts').child('BODYGUARD').val() <= 16 && newData.child('roleCounts').child('HUNTER').isNumber() && newData.child('roleCounts').child('HUNTER').val() >= 0 && newData.child('roleCounts').child('HUNTER').val() <= 16 && newData.child('roleCounts').child('CUPID').isNumber() && newData.child('roleCounts').child('CUPID').val() >= 0 && newData.child('roleCounts').child('CUPID').val() <= 16 && newData.child('roleCounts').child('MUTER').isNumber() && newData.child('roleCounts').child('MUTER').val() >= 0 && newData.child('roleCounts').child('MUTER').val() <= 16 && newData.child('roleCounts').child('CURSED').isNumber() && newData.child('roleCounts').child('CURSED').val() >= 0 && newData.child('roleCounts').child('CURSED').val() <= 16 && newData.child('roleCounts').child('LYCAN').isNumber() && newData.child('roleCounts').child('LYCAN').val() >= 0 && newData.child('roleCounts').child('LYCAN').val() <= 16 && newData.child('roleCounts').child('MASON').isNumber() && newData.child('roleCounts').child('MASON').val() >= 0 && newData.child('roleCounts').child('MASON').val() <= 16 && newData.child('roleCounts').child('PRINCE').isNumber() && newData.child('roleCounts').child('PRINCE').val() >= 0 && newData.child('roleCounts').child('PRINCE').val() <= 16 && newData.child('roleCounts').child('PACIFIST').isNumber() && newData.child('roleCounts').child('PACIFIST').val() >= 0 && newData.child('roleCounts').child('PACIFIST').val() <= 16 && newData.child('roleCounts').child('VILLAGE_IDIOT').isNumber() && newData.child('roleCounts').child('VILLAGE_IDIOT').val() >= 0 && newData.child('roleCounts').child('VILLAGE_IDIOT').val() <= 16 && newData.child('roleCounts').child('VILLAGER').isNumber() && newData.child('roleCounts').child('VILLAGER').val() >= 0 && newData.child('roleCounts').child('VILLAGER').val() <= 16 && newData.child('roleCounts').child('TANNER').isNumber() && newData.child('roleCounts').child('TANNER').val() >= 0 && newData.child('roleCounts').child('TANNER').val() <= 16 && (newData.child('roleCounts').child('WEREWOLF').val() + newData.child('roleCounts').child('TRAITOR').val() + newData.child('roleCounts').child('SORCERER').val() + newData.child('roleCounts').child('WOLF_MAN').val() + newData.child('roleCounts').child('WOLF_CUB').val() + newData.child('roleCounts').child('SEER').val() + newData.child('roleCounts').child('WITCH').val() + newData.child('roleCounts').child('BODYGUARD').val() + newData.child('roleCounts').child('HUNTER').val() + newData.child('roleCounts').child('CUPID').val() + newData.child('roleCounts').child('MUTER').val() + newData.child('roleCounts').child('CURSED').val() + newData.child('roleCounts').child('LYCAN').val() + newData.child('roleCounts').child('MASON').val() + newData.child('roleCounts').child('PRINCE').val() + newData.child('roleCounts').child('PACIFIST').val() + newData.child('roleCounts').child('VILLAGE_IDIOT').val() + newData.child('roleCounts').child('VILLAGER').val() + newData.child('roleCounts').child('TANNER').val()) >= 4 && (newData.child('roleCounts').child('WEREWOLF').val() + newData.child('roleCounts').child('TRAITOR').val() + newData.child('roleCounts').child('SORCERER').val() + newData.child('roleCounts').child('WOLF_MAN').val() + newData.child('roleCounts').child('WOLF_CUB').val() + newData.child('roleCounts').child('SEER').val() + newData.child('roleCounts').child('WITCH').val() + newData.child('roleCounts').child('BODYGUARD').val() + newData.child('roleCounts').child('HUNTER').val() + newData.child('roleCounts').child('CUPID').val() + newData.child('roleCounts').child('MUTER').val() + newData.child('roleCounts').child('CURSED').val() + newData.child('roleCounts').child('LYCAN').val() + newData.child('roleCounts').child('MASON').val() + newData.child('roleCounts').child('PRINCE').val() + newData.child('roleCounts').child('PACIFIST').val() + newData.child('roleCounts').child('VILLAGE_IDIOT').val() + newData.child('roleCounts').child('VILLAGER').val() + newData.child('roleCounts').child('TANNER').val()) <= 16"
        },
        "status": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === 'LOBBY'"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },
        "currentGameId": {
          ".write": false
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.isString()"
      }
    },
    "games": {
      "$gameId": {
        ".read": "auth != null",
        "roomCode": { ".write": false },
        "startedAt": { ".write": false },
        "dayNumber": { ".write": false },
        "phase": { ".write": false },
        "players": { ".write": false },
        "result": { ".write": false },
        "lastProtectedUid": { ".write": false },
        "lastDeaths": { ".write": false },
        "wolfCubBonusNightPending": { ".write": false },
        "narration": { ".write": false }
      }
    },
    "actions": {
      "$gameId": {
        "VOTE": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'VOTE' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() !== 'PACIFIST' && (root.child('private').child($gameId).child($uid).child('role').val() !== 'VILLAGE_IDIOT' || newData.child('target').val() !== null)"
          }
        },
        "HUNTER_SHOT": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === false && root.child('private').child($gameId).child($uid).child('role').val() === 'HUNTER'"
          }
        },
        "WOLVES": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WOLVES' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && (root.child('private').child($gameId).child($uid).child('role').val() === 'WEREWOLF' || root.child('private').child($gameId).child($uid).child('role').val() === 'WOLF_MAN' || root.child('private').child($gameId).child($uid).child('role').val() === 'WOLF_CUB')"
          }
        },
        "SEER": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'SEER' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'SEER'"
          }
        },
        "SORCERER": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'SORCERER' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'SORCERER'"
          }
        },
        "BODYGUARD": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'BODYGUARD' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'BODYGUARD'"
          }
        },
        "MUTER": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'MUTER' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'MUTER'"
          }
        },
        "WITCH_SAVE": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WITCH_SAVE' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'WITCH'"
          }
        },
        "WITCH_KILL": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WITCH_KILL' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'WITCH'"
          }
        },
        "PAIR_LOVERS": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'PAIR_LOVERS' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'CUPID'"
          }
        },
        "$phaseKey": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    },
    "private": {
      "$gameId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "chat": {
      "$gameId": {
        "village": {
          ".read": "auth != null && root.child('games').child($gameId).child('players').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('games').child($gameId).child('players').child(auth.uid).child('alive').val() === true && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        },
        "wolves": {
          ".read": "auth != null && (root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WEREWOLF' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'TRAITOR' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WOLF_MAN' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WOLF_CUB')",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WEREWOLF' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'TRAITOR' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WOLF_MAN' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WOLF_CUB') && root.child('games').child($gameId).child('players').child(auth.uid).child('alive').val() === true && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
