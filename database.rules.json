{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "settings": {
          ".write": "auth != null && newData.exists() && newData.parent().child('members').child(auth.uid).exists() && newData.parent().child('status').val() === 'LOBBY'",
          ".validate": "newData.hasChildren(['maxPlayers', 'rolesEnabled', 'remoteMode']) && newData.child('maxPlayers').isNumber() && newData.child('maxPlayers').val() >= 4 && newData.child('maxPlayers').val() <= 16 && newData.child('rolesEnabled').hasChildren(['BODYGUARD', 'TRAITOR', 'HUNTER', 'CUPID', 'MUTER', 'CURSED', 'LYCAN', 'TANNER']) && newData.child('remoteMode').isBoolean()"
        },
        "status": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === 'LOBBY'"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },
        "currentGameId": {
          ".write": false
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.isString()"
      }
    },
    "games": {
      "$gameId": {
        ".read": "auth != null",
        "roomCode": { ".write": false },
        "startedAt": { ".write": false },
        "dayNumber": { ".write": false },
        "phase": { ".write": false },
        "players": { ".write": false },
        "result": { ".write": false },
        "lastProtectedUid": { ".write": false },
        "lastDeaths": { ".write": false },
        "narration": { ".write": false }
      }
    },
    "actions": {
      "$gameId": {
        "VOTE": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'VOTE' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() !== 'PACIFIST'"
          }
        },
        "HUNTER_SHOT": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === false && root.child('private').child($gameId).child($uid).child('role').val() === 'HUNTER'"
          }
        },
        "WOLVES": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WOLVES' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'WEREWOLF'"
          }
        },
        "SEER": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'SEER' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'SEER'"
          }
        },
        "BODYGUARD": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'BODYGUARD' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'BODYGUARD'"
          }
        },
        "MUTER": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'MUTER' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'MUTER'"
          }
        },
        "WITCH_SAVE": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WITCH_SAVE' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'WITCH'"
          }
        },
        "WITCH_KILL": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'WITCH_KILL' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'WITCH'"
          }
        },
        "PAIR_LOVERS": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($gameId).child('phase').child('name').val() === 'PAIR_LOVERS' && root.child('games').child($gameId).child('players').child($uid).child('alive').val() === true && root.child('private').child($gameId).child($uid).child('role').val() === 'CUPID'"
          }
        },
        "$phaseKey": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    },
    "private": {
      "$gameId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "chat": {
      "$gameId": {
        "village": {
          ".read": "auth != null && root.child('games').child($gameId).child('players').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('games').child($gameId).child('players').child(auth.uid).child('alive').val() === true && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        },
        "wolves": {
          ".read": "auth != null && (root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WEREWOLF' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'TRAITOR')",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('private').child($gameId).child(auth.uid).child('role').val() === 'WEREWOLF' || root.child('private').child($gameId).child(auth.uid).child('role').val() === 'TRAITOR') && root.child('games').child($gameId).child('players').child(auth.uid).child('alive').val() === true && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
